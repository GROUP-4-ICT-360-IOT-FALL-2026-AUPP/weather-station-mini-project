import asyncio
import network
from machine import ADC, Pin
import env
from umqtt.simple import MQTTClient
import json

#FREQ = 0.2
PERIOD_MS = 5_000

MQTT_TOPIC_PUB = b"aupp/local-weather-station"
MQTT_CLIENT_ID = "weather-station-v1"
MQTT_BROKER = "public-mqtt-broker.bevywise.com"
MQTT_PORT = 1883
MQTT_KEEPALIVE = 60

def create_mqtt_client():
    return MQTTClient(
        client_id=MQTT_CLIENT_ID,
        server=MQTT_BROKER,
        port=MQTT_PORT,
        keepalive=MQTT_KEEPALIVE
    )

async def main(states):
    mqtt_connected = False
    wlan = network.WLAN(network.STA_IF)
    wlan.active(False)
    wlan.active(True)
    mqtt_client = None

    while True:
        await asyncio.sleep_ms(PERIOD_MS)
        if not wlan.isconnected():
            mqtt_connected = False
            print("[mqtt] WiFi disconnected. Reconnecting...")
            try:
                wlan.connect(env.WIFI_SSID, env.WIFI_PASSWORD)

            except Exception as e:
                print("[mqtt] WiFi connection error:", e)
            continue

        # if we're here, then we have a wifi connection
        if not mqtt_connected:
            print("[mqtt] connecting to client")
            try:
                mqtt_client = MQTTClient(
                    client_id=MQTT_CLIENT_ID,
                    server=MQTT_BROKER,
                    port=MQTT_PORT,
                    keepalive=MQTT_KEEPALIVE
                )
                mqtt_client.connect()
                mqtt_connected = True
            except OSError as e:
                print(f"[mqtt] Failed to connect to mqtt://{MQTT_BROKER}:{MQTT_PORT}")
                mqtt_connected = False
                mqtt_client = None
                continue

        # if we're here, then we have an mqtt connection
        print("[mqtt] attempting to send data")
        try:
            mqtt_client.publish(MQTT_TOPIC_PUB, json.dumps(states))
        except OSError as e:
            print(f"[mqtt] Failed to publish data to mqtt://{MQTT_BROKER}:{MQTT_PORT}")
            mqtt_connected = False
            try:
                mqtt_client.disconnect()
            except Exception:
                pass
            mqtt_client = None
